# Every start-up Setting of the App, with an example value.
# Start-up Settings are read from the environment and validated at start-up;
# a missing or invalid value stops the App.

# The listen address: an IP address and a port (1-65535).
APP_LISTEN_ADDRESS__HOST=127.0.0.1
APP_LISTEN_ADDRESS__PORT=8000

# The SQLite database file, created and migrated at start-up. It must live on a
# volume on a local disk, never on a network filesystem.
APP_DATABASE_FILE=app.db

# The built Frontend's directory, which the App serves. In development Vite serves
# the Frontend instead, and the App serves the API whether or not it is built.
APP_FRONTEND_DIRECTORY=../frontend/dist
