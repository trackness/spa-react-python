{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"target": "es2023",
		"lib": ["ES2023", "DOM"],
		"types": ["vite/client"],
		"skipLibCheck": true,
		"paths": { "@/*": ["./src/*"] },

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",

		/* Linting; Biome reports unused code, because tsc would report it in the generated Client */
		"strict": true,
		// stays off: the generated Client does not compile with it (docs/adr/0002)
		"exactOptionalPropertyTypes": false,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src"]
}
